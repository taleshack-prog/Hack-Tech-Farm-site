# ---------------------------------------------------------------------------
# Variáveis das funções serverless (/api). Configure no painel da Vercel,
# em Settings > Environment Variables. NUNCA comite este arquivo preenchido.
# ---------------------------------------------------------------------------

# Projeto Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role: ignora o RLS e por isso só pode viver aqui, no servidor.
# Se ela aparecer em js/config.js ou em qualquer arquivo do front, considere
# vazada e gere outra imediatamente no painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (opcional). Sem ela, o honeypot, o time trap e o
# rate limit continuam ativos. Com ela, o formulário fica bem mais protegido.
TURNSTILE_SECRET=
