# ---------------------------------------------------------------------------
# Variáveis das funções serverless. Configure no painel da Vercel, em
# Settings > Environment Variables. NUNCA comite este arquivo preenchido.
# ---------------------------------------------------------------------------

# --- Login pelo GitHub (OAuth App) -----------------------------------------
# Crie em github.com/settings/developers > New OAuth App.
# Callback URL: https://SEU-DOMINIO/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repositório onde o catálogo é gravado, no formato usuario/repositorio
GITHUB_REPO=taleshack-prog/Hack-Tech-Farm-site
GITHUB_BRANCH=main

# Chave para cifrar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Brevo: newsletter e formulário de contato ------------------------------
# app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=

# Id da lista de newsletter (Contacts > Lists). Opcional.
BREVO_LIST_ID=

# Para onde as mensagens do formulário são enviadas
CONTACT_TO=contato@hacktechfarm.com

# Remetente das mensagens. Precisa ser um domínio verificado no Brevo,
# senão o e-mail é recusado ou cai em spam.
CONTACT_FROM=site@hacktechfarm.com
